# Local development
PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/wakuru_db
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=2h

# Render deployment
# Set DATABASE_URL to your Render PostgreSQL connection string.
# Set CORS_ORIGIN to your Vercel frontend URL.
# Example:
# DATABASE_URL=postgres://user:password@host:5432/wakuru_db
# CORS_ORIGIN=https://wakuru-portfolio-git-main-wakulu-jumas-projects.vercel.app
